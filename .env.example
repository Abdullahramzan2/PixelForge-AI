# App
APP_NAME=PixelForge AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (install locally — see docs/DATABASE.md)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pixelforge

# Or set a full connection string (overrides POSTGRES_* above)
# DATABASE_URL=postgresql://pixelforge:pixelforge@localhost:5432/pixelforge

# Image generation providers
HUGGINGFACE_API_TOKEN=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

# Background removal
REMOVEBG_API_KEY=

# Default provider: huggingface | replicate | stability
DEFAULT_IMAGE_PROVIDER=huggingface

# Storage
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_UPLOAD_SIZE_MB=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
